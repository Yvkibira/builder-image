{
    "$schema": "https://opencode.ai/config.json",
    "model": "deepseek/deepseek-flash",
    "providers": {
        "deepseek": {
            "env": ["SHIKA_LLM_TOKEN", "DEEPSEEK_API_KEY"],
            "settings": {
                "baseURL": "{env:SHIKA_LLM_BASE_URL}"
            }
        }
    },
    "update": "disable",
    "policies": [
        {
            "action": "provider.use",
            "resource": "opencode",
            "effect": "deny"
        }
    ]
}
